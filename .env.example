API_KEY_HASH=

# Chosen when the service starts.
# A request may name another chat model with a header. The embedding model and
# the store cannot be swapped per request -- the collections are made for them.
LLM_MODEL=gpt-4o-mini

# Replacing the below will require re-uploading the entire knowledge base.
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
VECTOR_STORE=qdrant

QDRANT_URL=http://localhost:6333

# Chunking. Sizes are in tokens, counted the same way the models count them.
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5

# The most a document may hold and still be returned whole
MAX_DOCUMENT_TOKENS=5000

# A document at or under this size is stored whole instead of being split.
SINGLE_CHUNK_MAX_TOKENS=1000

# Prior turns carried into a chat request.
MAX_HISTORY_MESSAGES=5

# Tool calls the agent may make before it must answer.
MAX_AGENT_STEPS=6

# The clock the current_datetime tool answers with, as an IANA zone name.
TIMEZONE=Asia/Amman

# Which tools the agent may reach for. A tool set to false is never offered to
# the model, so it cannot be called at all.
TOOL_SEARCH_KNOWLEDGE_BASE=true
TOOL_READ_DOCUMENT=true
TOOL_LIST_DOCUMENT_CHUNKS=true
TOOL_EXPAND_CHUNK=true
TOOL_CURRENT_DATETIME=true
TOOL_TRANSLATE=true

# Hosted by OpenAI and paid for with the caller key, so it is offered only when
# the model answering is an OpenAI one.
TOOL_OPENAI_WEB_SEARCH=true
