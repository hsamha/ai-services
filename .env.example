API_KEY_HASH=

# Chosen when the service starts.
# A request may name another chat model with a header. The embedding model and
# the store cannot be swapped per request -- the collections are made for them.
LLM_MODEL=gpt-4o-mini

# Replacing the below will require re-uploading the entire knowledge base.
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=qdrant

QDRANT_URL=http://localhost:6333

# Chroma, when VECTOR_STORE=chroma
# memory     = inside the API process, emptied on restart, nothing to run
# persistent = a folder on disk, survives restarts
# server     = a Chroma server of its own, set CHROMA_HOST and CHROMA_PORT
CHROMA_MODE=memory
CHROMA_PATH=./chroma_storage
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Chunking
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5

# The most a document may hold and still be returned whole
MAX_DOCUMENT_TOKENS=5000
