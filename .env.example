API_KEY=change-me

# Defaults -- a request may name another model with a header
LLM_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
VECTOR_STORE=qdrant

QDRANT_URL=http://localhost:6333

# Chroma, when VECTOR_STORE=chroma
# memory     = inside the API process, emptied on restart, nothing to run
# persistent = a folder on disk, survives restarts
# server     = a Chroma server of its own, set CHROMA_HOST and CHROMA_PORT
CHROMA_MODE=memory
CHROMA_PATH=./chroma_storage
CHROMA_HOST=localhost
CHROMA_PORT=8000

# Chunking
CHUNK_SIZE=300
CHUNK_OVERLAP=50

# Retrieval
TOP_K=5
